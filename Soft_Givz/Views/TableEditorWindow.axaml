<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Soft_Givz.ViewModels"
        x:Class="Soft_Givz.Views.TableEditorWindow"
        x:DataType="vm:TableEditorViewModel"
        Title="Работа с БД"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding TableName, StringFormat='Таблица: {0}'}"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="10,5"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="DarkRed" Margin="20,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Name="DataGridControl"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  AutoGenerateColumns="False"
                  CellEditEnding="OnCellEditEnding"
                  BorderThickness="1" BorderBrush="Gray"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Удалить выбранную строку"
                    Command="{Binding DeleteSelectedCommand}"
                    CommandParameter="{Binding #DataGridControl.SelectedItem}"
                    Padding="15,8"/>
        </StackPanel>

    </Grid>
</Window>