<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Soft_Givz.Views.TableSelectWindow"
        Title="Выбор таблицы"
        Width="300" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Выберите таблицу:" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Button Content="doroga1"  Tag="doroga1"  Click="OnTableClick"/>
        <Button Content="doroga2"  Tag="doroga2"  Click="OnTableClick"/>
        <Button Content="doroga"   Tag="doroga"   Click="OnTableClick"/>
        <Separator/>
        <Button Content="vedom1"   Tag="vedom1"   Click="OnTableClick"/>
        <Button Content="vedom2"   Tag="vedom2"   Click="OnTableClick"/>
        <Button Content="vedom"    Tag="vedom"    Click="OnTableClick"/>
    </StackPanel>
</Window>