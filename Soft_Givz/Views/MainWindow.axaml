<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Soft_Givz.ViewModels"
        x:Class="Soft_Givz.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Учет ПТЖТ"
        Width="1100" Height="700">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

        <!-- Верхняя левая панель: две кнопки -->
        <StackPanel Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="10">
            <Button Content="Ввод/корректив данных"
                    Padding="15,8"
                    Command="{Binding ToggleEntryMenuCommand}" />
            <Button Content="Работа с БД"
                    Padding="15,8"
                    Command="{Binding OpenDbEditorCommand}" />
        </StackPanel>

        <!-- Блок кнопок справа -->
        <StackPanel Grid.Row="0" Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="10" Spacing="20"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsEntryMenuVisible}">

            <!-- Группа: Ведомости -->
            <StackPanel Orientation="Vertical" Spacing="8">
                <Button Content="Ввод в ведомость 1"
                        Padding="15,8"
                        Command="{Binding EnterVedomost1Command}" />
                <Button Content="Ввод в ведомость 2"
                        Padding="15,8"
                        Command="{Binding EnterVedomost2Command}" />
                <Separator Margin="0,6"/>
                <Button Content="Сравнить ведомости"
                        Padding="15,8"
                        Command="{Binding CompareVedomCommand}" />
                <Button Content="Очистить ведомости"
                        Padding="15,8"
                        Command="{Binding ClearVedomCommand}" />
            </StackPanel>

            <!-- Группа: Дороги -->
            <StackPanel Orientation="Vertical" Spacing="8">
                <Button Content="Ввод в дорога 1"
                        Padding="15,8"
                        Command="{Binding EnterDoroga1Command}" />
                <Button Content="Ввод в дорога 2"
                        Padding="15,8"
                        Command="{Binding EnterDoroga2Command}" />
                <Separator Margin="0,6"/>
                <Button Content="Сравнить дороги"
                        Padding="15,8"
                        Command="{Binding CompareDorogaCommand}" />
                <Button Content="Очистить дороги"
                        Padding="15,8"
                        Command="{Binding ClearDorogaCommand}" />
            </StackPanel>

        </StackPanel>

        <!-- Рабочая область -->
        <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="10" />

    </Grid>
</Window>